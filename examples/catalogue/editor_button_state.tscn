[gd_scene format=3]

[ext_resource type="Script" path="res://examples/catalogue/editor_button_state.gd" id="script"]
[ext_resource type="PackedScene" path="res://rookframe/ui/editor/EditorToolButton.tscn" id="button"]

[sub_resource type="ViewportTexture" id="preview"]
resource_local_to_scene = true
viewport_path = NodePath("Viewport")

[node name="EditorButtonState" type="TextureRect"]
custom_minimum_size = Vector2(84, 76)
mouse_filter = 2
texture = SubResource("preview")
expand_mode = 1
script = ExtResource("script")

[node name="Viewport" type="SubViewport" parent="."]
disable_3d = true
transparent_bg = true
size = Vector2i(100, 76)
handle_input_locally = true

[node name="Button" parent="Viewport" instance=ExtResource("button")]
