[node name="Canvas" type="Control" parent="Workspace/World"]
layout_mode = 2
custom_minimum_size = Vector2(0, 440)
clip_contents = true
size_flags_vertical = 3

[node name="Map" type="Control" parent="Workspace/World/Canvas"]
layout_mode = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
