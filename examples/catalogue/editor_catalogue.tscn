[node name="EditorCatalogue" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 18
script = ExtResource("script")

[node name="Heading" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Heading"]
layout_mode = 2
theme_type_variation = &"editor_heading"
text = "In-game editor"
size_flags_horizontal = 3

[node name="Tag" type="Label" parent="Heading"]
layout_mode = 2
theme_type_variation = &"editor_accent"
text = "BUTTONS & SURFACES"

[node name="States" type="GridContainer" parent="."]
layout_mode = 2
columns = 6
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
unique_name_in_owner = true

[node name="Normal" type="VBoxContainer" parent="States"]
layout_mode = 2
theme_override_constants/separation = 0
size_flags_horizontal = 3

[node name="Preview" parent="States/Normal" instance=ExtResource("state")]
layout_mode = 2
state = 0

[node name="Name" type="Label" parent="States/Normal"]
layout_mode = 2
theme_type_variation = &"editor_meta"
text = "Normal"
horizontal_alignment = 1

