[gd_scene format=3]

[ext_resource type="Script" path="res://examples/catalogue/button_state.gd" id="script"]
[ext_resource type="PackedScene" path="res://rookframe/ui/menu/MenuButtonStandard.tscn" id="button"]
[ext_resource type="Theme" path="res://rookframe/ui/menu/cyberpunk/CyberpunkTheme.tres" id="theme"]

[sub_resource type="ViewportTexture" id="preview"]
resource_local_to_scene = true
viewport_path = NodePath("Viewport")

[node name="ButtonState" type="TextureRect"]
custom_minimum_size = Vector2(0, 100)
size_flags_horizontal = 3
mouse_filter = 2
texture = SubResource("preview")
expand_mode = 1
script = ExtResource("script")

[node name="Viewport" type="SubViewport" parent="."]
disable_3d = true
transparent_bg = true
size = Vector2i(600, 100)
handle_input_locally = true

[node name="Layout" type="MarginContainer" parent="Viewport"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 18.0
offset_right = -40.0
offset_bottom = -18.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")

[node name="Buttons" type="MarginContainer" parent="Viewport/Layout"]
layout_mode = 2
theme_type_variation = &"menu_buttons"

[node name="Button" parent="Viewport/Layout/Buttons" instance=ExtResource("button")]
layout_mode = 2
size_flags_vertical = 4
